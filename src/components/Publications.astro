---
import type { Lang } from '../data/types';
import { cv as cvEn } from '../data/cv.en';
import { cv as cvEs } from '../data/cv.es';
import { ui, formatMonthYear } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = lang === 'es' ? cvEs : cvEn;
const t = ui[lang];
---

<section id="publications" aria-labelledby="publications-heading" class="py-12">
  <SectionHeading kicker={t.publicationsKicker} title={t.publicationsTitle} />
  <div class="grid gap-5 sm:grid-cols-2">
    {
      data.publications.map((pub) => (
        <article class="flex flex-col rounded-2xl border border-stone-200/60 bg-white/70 p-6 shadow-[0_4px_20px_-8px_rgba(120,80,40,0.15)]">
          <p class="text-xs font-semibold tracking-wide text-clay-600 uppercase">
            {pub.company_medium} ·{' '}
            {formatMonthYear(pub.date.month, pub.date.year, lang)}
          </p>
          <h3 class="font-display mt-2 text-lg font-semibold text-stone-900">
            <a
              href={pub.link}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-clay-200 decoration-2 underline-offset-4 hover:text-clay-700 hover:decoration-clay-600"
            >
              {pub.title}
            </a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            {pub.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
