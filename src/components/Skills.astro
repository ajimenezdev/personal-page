---
import type { Lang } from '../data/types';
import { cv as cvEn } from '../data/cv.en';
import { cv as cvEs } from '../data/cv.es';
import { ui } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = lang === 'es' ? cvEs : cvEn;
const t = ui[lang];
---

<section id="skills" aria-labelledby="skills-heading" class="py-12">
  <SectionHeading kicker={t.skillsKicker} title={t.skillsTitle} />
  <div class="grid gap-8 sm:grid-cols-3">
    {
      data.skillGroups.map((group) => (
        <div>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-clay-700">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2" aria-label={group.title}>
            {group.items.map((item) => (
              <li class="rounded-full border border-stone-200/70 bg-white/70 px-3.5 py-1.5 text-sm font-medium text-stone-800 shadow-[0_2px_10px_-4px_rgba(120,80,40,0.15)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
