---
import type { Lang } from '../data/types';
import { cv as cvEn } from '../data/cv.en';
import { cv as cvEs } from '../data/cv.es';
import { ui, formatMonthYear } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = lang === 'es' ? cvEs : cvEn;
const t = ui[lang];
---

<section id="experience" aria-labelledby="experience-heading" class="py-12">
  <SectionHeading kicker={t.experienceKicker} title={t.experienceTitle} />
  <ol class="relative space-y-8 border-l-2 border-clay-100 pl-0">
    {
      data.jobs.map((job) => {
        const isCurrent = job.duration === null;
        const period = isCurrent
          ? `${formatMonthYear(job.begin.month, job.begin.year, lang)} — ${t.present}`
          : `${formatMonthYear(job.begin.month, job.begin.year, lang)} · ${job.duration}`;
        return (
          <li class="relative pl-8">
            <span
              aria-hidden="true"
              class:list={[
                'absolute top-1.5 -left-[7px] h-3 w-3 rounded-full ring-4 ring-cream-50',
                isCurrent ? 'bg-clay-600' : 'bg-clay-200',
              ]}
            />
            <div class="rounded-2xl border border-stone-200/60 bg-white/70 p-6 shadow-[0_4px_20px_-8px_rgba(120,80,40,0.15)]">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-xl font-semibold text-stone-900">
                  {job.company}
                </h3>
                <p class="text-sm font-medium text-clay-700">{period}</p>
              </div>
              <p class="mt-1 text-sm font-medium text-stone-600">
                {job.occupation} · {job.location}
              </p>
              {job.description ? (
                <p class="mt-3 leading-relaxed text-stone-700">
                  {job.description}
                </p>
              ) : (
                <p class="mt-3 text-sm text-stone-400 italic">
                  {t.metaDescriptionPlaceholder}
                </p>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
