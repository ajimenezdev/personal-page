---
import type { Lang } from '../data/types';
import { cv as cvEn } from '../data/cv.en';
import { cv as cvEs } from '../data/cv.es';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = lang === 'es' ? cvEs : cvEn;
const t = ui[lang];
---

<header
  class="sticky top-0 z-40 border-b border-stone-200/70 bg-cream-50/85 backdrop-blur"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3">
    <a
      href={lang === 'es' ? '/es/#top' : '/#top'}
      class="font-display text-lg font-semibold text-stone-900"
    >
      {t.siteOwner}
    </a>

    <nav aria-label={t.siteOwner} class="min-w-0">
      <ul
        class="flex items-center gap-1 overflow-x-auto text-sm whitespace-nowrap"
      >
        {
          data.headerLinks.map((link) => (
            <li>
              <a
                href={`${lang === 'es' ? '/es' : ''}/#${link.url}`}
                class="rounded-full px-3 py-1.5 text-stone-600 transition-colors hover:bg-clay-50 hover:text-clay-700"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      role="group"
      aria-label={t.languageLabel}
      class="flex shrink-0 items-center rounded-full border border-stone-200 bg-white p-0.5 text-xs font-medium"
    >
      <a
        href="/"
        hreflang="en"
        aria-current={lang === 'en' ? 'true' : undefined}
        class:list={[
          'rounded-full px-2.5 py-1 transition-colors',
          lang === 'en'
            ? 'bg-clay-700 text-white'
            : 'text-stone-500 hover:text-clay-700',
        ]}
      >
        EN
      </a>
      <a
        href="/es/"
        hreflang="es"
        aria-current={lang === 'es' ? 'true' : undefined}
        class:list={[
          'rounded-full px-2.5 py-1 transition-colors',
          lang === 'es'
            ? 'bg-clay-700 text-white'
            : 'text-stone-500 hover:text-clay-700',
        ]}
      >
        ES
      </a>
    </div>
  </div>
</header>
