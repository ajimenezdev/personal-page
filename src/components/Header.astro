---
import type { Lang } from '../data/types';
import { cv as cvEn } from '../data/cv.en';
import { cv as cvEs } from '../data/cv.es';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = lang === 'es' ? cvEs : cvEn;
const t = ui[lang];

// The desktop nav shows at most 6 links (working-memory limit from the
// Impeccable critique): the rest live under the "More" dropdown. The
// mobile menu keeps the full list of 9. Splitting by url keeps the data
// (headerLinks) untouched.
const primaryUrls = ['about', 'skills', 'experience', 'ai', 'projects', 'contact'];
const primaryLinks = data.headerLinks.filter((link) => primaryUrls.includes(link.url));
const moreLinks = data.headerLinks.filter((link) => !primaryUrls.includes(link.url));
---

<header
  class="sticky top-0 z-40 border-b border-stone-200/70 bg-cream-50/85 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a
      href={lang === 'es' ? '/es/#top' : '/#top'}
      class="shrink-0 font-display text-lg font-semibold whitespace-nowrap text-stone-900"
    >
      {t.siteOwner}
    </a>

    <nav aria-label={t.siteOwner} class="hidden min-w-0 md:block">
      <ul class="flex items-center gap-1 text-sm whitespace-nowrap">
        {
          primaryLinks.map((link) => (
            <li>
              <a
                href={`${lang === 'es' ? '/es' : ''}/#${link.url}`}
                data-spy={link.url}
                class="rounded-full px-2.5 py-2.5 text-stone-600 transition-colors hover:bg-clay-50 hover:text-clay-700"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            id="more-menu-button"
            type="button"
            popovertarget="more-menu"
            aria-expanded="false"
            aria-controls="more-menu"
            aria-haspopup="true"
            class="inline-flex items-center gap-1 rounded-full px-2.5 py-2.5 text-stone-600 transition-colors hover:bg-clay-50 hover:text-clay-700"
          >
            {t.moreLabel}
            <svg
              id="more-menu-chevron"
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div
            id="more-menu"
            popover="auto"
            class="hidden"
          >
            <ul>
              {
                moreLinks.map((link) => (
                  <li>
                    <a
                      href={`${lang === 'es' ? '/es' : ''}/#${link.url}`}
                      data-spy={link.url}
                      class="block rounded-xl px-3 py-2.5 text-sm text-stone-700 transition-colors hover:bg-clay-50 hover:text-clay-700"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <div
      role="group"
      aria-label={t.languageLabel}
      class="hidden shrink-0 items-center rounded-full border border-stone-200 bg-paper p-0.5 text-xs font-medium md:flex"
    >
      <a
        href="/"
        hreflang="en"
        aria-current={lang === 'en' ? 'true' : undefined}
        class:list={[
          'rounded-full px-2.5 py-2 transition-colors',
          lang === 'en'
            ? 'bg-clay-700 text-white'
            : 'text-stone-500 hover:text-clay-700',
        ]}
      >
        EN
      </a>
      <a
        href="/es/"
        hreflang="es"
        aria-current={lang === 'es' ? 'true' : undefined}
        class:list={[
          'rounded-full px-2.5 py-2 transition-colors',
          lang === 'es'
            ? 'bg-clay-700 text-white'
            : 'text-stone-500 hover:text-clay-700',
        ]}
      >
        ES
      </a>
    </div>

    <button
      id="menu-button"
      type="button"
      popovertarget="mobile-menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.menuLabel}
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-stone-700 transition-colors hover:bg-clay-50 hover:text-clay-700 md:hidden"
    >
      <svg
        id="menu-icon-open"
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        id="menu-icon-close"
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="hidden"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    popover="auto"
    class="hidden border-t border-stone-200/70 bg-cream-50/85 backdrop-blur md:hidden"
  >
    <nav aria-label={t.siteOwner} class="mx-auto max-w-6xl px-5 py-2">
      <ul>
        {
          data.headerLinks.map((link) => (
            <li>
              <a
                href={`${lang === 'es' ? '/es' : ''}/#${link.url}`}
                data-spy={link.url}
                class="block rounded-xl px-3 py-3 text-base text-stone-700 transition-colors hover:bg-clay-50 hover:text-clay-700"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-2 border-t border-stone-200/70 pt-4 pb-2">
        <div
          role="group"
          aria-label={t.languageLabel}
          class="inline-flex items-center rounded-full border border-stone-200 bg-paper p-0.5 text-sm font-medium"
        >
          <a
            href="/"
            hreflang="en"
            aria-current={lang === 'en' ? 'true' : undefined}
            class:list={[
              'rounded-full px-3 py-1.5 transition-colors',
              lang === 'en'
                ? 'bg-clay-700 text-white'
                : 'text-stone-500 hover:text-clay-700',
            ]}
          >
            English
          </a>
          <a
            href="/es/"
            hreflang="es"
            aria-current={lang === 'es' ? 'true' : undefined}
            class:list={[
              'rounded-full px-3 py-1.5 transition-colors',
              lang === 'es'
                ? 'bg-clay-700 text-white'
                : 'text-stone-500 hover:text-clay-700',
            ]}
          >
            Español
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const panel = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  // The menu is a native popover (`popover="auto"`, opened by the button's
  // `popovertarget`): light-dismiss, Escape and focus return come from the
  // browser. Only sync the button state and icons, and close the menu
  // when a link inside it is followed (a click inside a popover does not
  // close it by itself).
  panel?.addEventListener('toggle', () => {
    const open = panel.matches(':popover-open');
    button?.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => panel.hidePopover?.());
  });

  // "More" dropdown in the desktop nav: same native popover pattern as
  // the mobile menu (light-dismiss, Escape and focus return from the
  // browser). Only sync the button state and chevron, and close the
  // dropdown when a link inside it is followed.
  const moreButton = document.getElementById('more-menu-button');
  const morePanel = document.getElementById('more-menu');
  const moreChevron = document.getElementById('more-menu-chevron');

  morePanel?.addEventListener('toggle', () => {
    const open = morePanel.matches(':popover-open');
    moreButton?.setAttribute('aria-expanded', String(open));
    moreChevron?.classList.toggle('rotate-180', open);
  });

  morePanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => morePanel.hidePopover?.());
  });

  // Scroll-spy: highlight the nav link of the section currently in view
  // (desktop nav, "More" dropdown and mobile menu share the same state).
  // `data-spy` carries the section id on every nav link; the "More"
  // button lights up too when the active section is one of the grouped
  // ones. The hero (`top`) has no nav link, so nothing is active there.
  const spyLinks = [...document.querySelectorAll('[data-spy]')];
  const groupedUrls = ['education', 'publications', 'hobbies'];

  function setSpyLinkActive(link, active) {
    if (active) {
      link.setAttribute('aria-current', 'true');
    } else {
      link.removeAttribute('aria-current');
    }
    // Each link's base color is stone-600 (desktop) or stone-700 (mobile
    // menu and dropdown); the active style is the existing clay-700.
    const baseColor = link.classList.contains('text-stone-700')
      ? 'text-stone-700'
      : 'text-stone-600';
    link.classList.toggle('text-clay-700', active);
    link.classList.toggle(baseColor, !active);
  }

  function setActiveSection(id) {
    spyLinks.forEach((link) => setSpyLinkActive(link, link.dataset.spy === id));
    const moreActive = groupedUrls.includes(id);
    if (moreActive) {
      moreButton?.setAttribute('aria-current', 'true');
    } else {
      moreButton?.removeAttribute('aria-current');
    }
    moreButton?.classList.toggle('text-clay-700', moreActive);
    moreButton?.classList.toggle('text-stone-600', !moreActive);
  }

  const sections = [...document.querySelectorAll('section[id]')];
  const inView = new Set();
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          inView.add(entry.target.id);
        } else {
          inView.delete(entry.target.id);
        }
      });
      if (!inView.size) return;
      // When two sections straddle the band, the topmost one wins.
      const topmost = [...inView].sort(
        (a, b) =>
          document.getElementById(a)?.getBoundingClientRect().top -
          document.getElementById(b)?.getBoundingClientRect().top,
      )[0];
      setActiveSection(topmost);
    },
    // A band near the top of the viewport: the section crossing it is
    // the one the reader is in.
    { rootMargin: '-10% 0px -80% 0px' },
  );
  sections.forEach((section) => spy.observe(section));
</script>
