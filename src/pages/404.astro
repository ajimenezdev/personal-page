---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en">
  <section class="py-24 text-center sm:py-32" aria-labelledby="not-found-heading">
    <div class="mx-auto max-w-xl">
      <p
        class="font-display text-7xl font-semibold text-clay-600 sm:text-8xl"
        aria-hidden="true"
      >
        404
      </p>
      <h1
        id="not-found-heading"
        class="mt-4 font-display text-3xl font-semibold text-stone-900"
      >
        Page not found
      </h1>
      <p class="mt-3 text-stone-600">
        This page doesn't exist or was moved. / Esta página no existe o fue
        movida.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="rounded-full bg-clay-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-clay-800"
        >
          ← Back home
        </a>
        <a
          href="/es/"
          class="rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-stone-700 transition-colors hover:border-clay-200 hover:text-clay-700"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
